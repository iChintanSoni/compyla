{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:compyla:compose-summary:0.2",
  "title": "Compyla compose summary",
  "description": "A normative projection of the composed model, used by the compose suite to pin slide segmentation, layout selection, xlsx placement and formula translation without fixing internal data structures. Implementations derive it from their own composed model.",
  "oneOf": [
    {
      "type": "object",
      "required": ["format", "slides"],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "pptx" },
        "slides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "layout", "notes", "content"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": ["string", "null"], "description": "Plain text of the title runs, or null." },
              "layout": { "type": "string", "description": "The resolved layout name." },
              "notes": { "type": "boolean", "description": "Whether the slide has speaker notes." },
              "content": {
                "description": "Content block types in order: paragraph, list, heading (demoted), table, media, code, quote, col, or directive:<name>.",
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["format", "sheets"],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "xlsx" },
        "sheets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "ranges"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "ranges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["titleRow", "noteRow", "headerRow", "firstColumn", "lastColumn", "lastRow", "columnTypes", "formulas"],
                  "additionalProperties": false,
                  "properties": {
                    "titleRow": { "type": ["integer", "null"], "minimum": 1 },
                    "noteRow": { "type": ["integer", "null"], "minimum": 1 },
                    "headerRow": { "type": "integer", "minimum": 1 },
                    "firstColumn": { "type": "string", "pattern": "^[A-Z]{1,3}$" },
                    "lastColumn": { "type": "string", "pattern": "^[A-Z]{1,3}$" },
                    "lastRow": { "type": "integer", "minimum": 1 },
                    "columnTypes": {
                      "type": "array",
                      "items": { "enum": ["number", "currency", "percent", "date", "text", "boolean"] }
                    },
                    "formulas": {
                      "description": "Placed address → translated formula text (without the leading =).",
                      "type": "object",
                      "patternProperties": { "^[A-Z]{1,3}[1-9][0-9]*$": { "type": "string" } },
                      "additionalProperties": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
