{
  "$schema": "./diagnostics.schema.json",
  "specVersion": "0.2",
  "description": "Registry of every Compyla diagnostic code and operation error (markdown-spec.md §11, §10.6). Codes are public API: never reused for a different meaning; retired codes stay with status \"retired\" (§14).",
  "diagnostics": [
    {
      "code": "ambiguous_break",
      "severity": "warning",
      "stage": "parse",
      "profiles": [
        "*"
      ],
      "strictPromotable": false,
      "position": "underline",
      "since": "0.2",
      "status": "active",
      "spec": "§4.9",
      "summary": "A paragraph line directly above --- became a level-2 heading; a break was probably intended."
    },
    {
      "code": "directive_malformed",
      "severity": "warning",
