{
  "name": "@compyla/xlsx",
  "version": "0.1.0",
  "description": "Native xlsx renderer: H1 sections -> sheets, tables -> ranges, parsed + allowlisted formulas, columns/anchor/table directives, byte-reproducible output.",
  "type": "module",
  "license": "MIT",
  "author": "Chintan Soni <ichintansoni@gmail.com>",
  "homepage": "https://github.com/iChintanSoni/compyla#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/iChintanSoni/compyla.git",
    "directory": "packages/xlsx"
  },
  "bugs": "https://github.com/iChintanSoni/compyla/issues",
  "keywords": ["markdown", "xlsx", "excel", "spreadsheet", "compyla"],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@compyla/core": "workspace:*",
    "@compyla/ooxml": "workspace:*",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
