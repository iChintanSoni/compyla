    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@compyla/core": "workspace:*",
    "@compyla/fonts": "workspace:*",
    "@compyla/ooxml": "workspace:*",
    "image-size": "^2.0.4",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
