{
  "name": "@compyla/sdk",
  "version": "0.1.0",
  "description": "Compyla SDK: convert/lint/template orchestration over the engine, with opt-in renderer loading. The layer every app (CLI, web, server) builds on — apps hold no engine logic of their own.",
  "type": "module",
  "license": "MIT",
  "author": "Chintan Soni <ichintansoni@gmail.com>",
  "homepage": "https://github.com/iChintanSoni/compyla#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/iChintanSoni/compyla.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/iChintanSoni/compyla/issues",
  "keywords": ["markdown", "docx", "pptx", "xlsx", "sdk", "compyla"],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@compyla/core": "workspace:*"
  },
  "devDependencies": {
    "@compyla/docx": "workspace:*",
    "@compyla/pdf": "workspace:*",
    "@compyla/pptx": "workspace:*",
    "@compyla/xlsx": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
