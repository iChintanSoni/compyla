{
  "name": "@compyla/pdf",
  "version": "0.1.0",
  "description": "Native pdf renderer: tokens -> laid-out PDF pages, no docx conversion.",
  "type": "module",
  "license": "MIT",
  "author": "Chintan Soni <ichintansoni@gmail.com>",
  "homepage": "https://github.com/iChintanSoni/compyla#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/iChintanSoni/compyla.git",
    "directory": "packages/pdf"
  },
  "bugs": "https://github.com/iChintanSoni/compyla/issues",
  "keywords": ["markdown", "pdf", "compyla"],
  "publishConfig": {
    "access": "public"
  },
